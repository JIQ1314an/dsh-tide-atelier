{
  "name": "dsh-tide-atelier",
  "version": "0.1.0",
  "description": "Tide Atelier: turn DSH agent activity into a living constellation, garden or city, with a 3D whale-maid companion. Client-only, no network.",
  "type": "module",
  "main": "index.js",
  "license": "MIT AND CC-BY-NC-SA-4.0",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "LICENSE-ASSETS",
    "NOTICE",
    "docs/model-preview.png",
    "docs/ui-constellation.png"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "whale-girl",
    "generative-art",
    "constellation",
    "threejs",
    "webgl"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JIQ1314an/dsh-tide-atelier.git"
  },
  "bugs": {
    "url": "https://github.com/JIQ1314an/dsh-tide-atelier/issues"
  },
  "homepage": "https://github.com/JIQ1314an/dsh-tide-atelier#readme",
  "author": "Tide Atelier contributors"
}
